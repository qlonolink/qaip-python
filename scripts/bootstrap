#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
variant="${SDK_PYDANTIC_VARIANT:-v2}"
case "$variant" in
  v1|v2) ;;
  *) echo 'SDK_PYDANTIC_VARIANT must be v1 or v2' >&2; exit 1 ;;
esac
uv sync --frozen --all-extras --no-default-groups --group dev --group build \
  --group "pydantic-$variant" --no-install-project
uv pip install --python "${UV_PROJECT_ENVIRONMENT:-.venv}/bin/python" --no-deps --no-build-isolation --editable .
